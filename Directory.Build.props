<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Authors>milten89</Authors>
    <Company>OpenUrzednik Open Source</Company>
    <Description>Modern, high-performance .NET SDK for Polish government public APIs.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/milten89/OpenUrzednik.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>GUS;KRS;NBP;REGON;NIP;Biała-Lista;API;Poland;Gov</PackageTags>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <!-- In CI every warning fails the build. NuGet audit warnings stay warnings: a new advisory (NU1901-NU1904) or an
         unreachable vulnerability feed (NU1900, NU1905) would otherwise turn every PR red for reasons outside the change. -->
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>

    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Strong naming (ADR-0005): every assembly, tests included, is signed with this key. The key pair is checked in on purpose,
         as Microsoft's library guidance recommends: a strong name is an identity, not a security boundary, and anyone may rebuild
         with it. Never change or replace the key: that changes the identity of every assembly (a binary breaking change).
         PublicKey is the full public key; the SDK puts it into every InternalsVisibleTo that has no Key of its own. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)OpenUrzednik.snk</AssemblyOriginatorKeyFile>
    <PublicKey></PublicKey>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fallback for a project without its own README.md; each package's own README is packed by its csproj. -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false"
          Condition="!Exists('$(MSBuildProjectDirectory)\README.md')" />
  </ItemGroup>
</Project>