<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources of this repository (#292): nuget.org only, whatever the machine-level NuGet.Config adds, and every package
  mapped to it, as Microsoft's supply chain best practices recommend:
  https://learn.microsoft.com/nuget/concepts/security-best-practices#nuget-configuration
  Another source needs the maintainer's approval and its own packageSource mapping (.claude/rules/dependencies.md).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- So a machine-level config that disables a source named nuget.org can't disable this one. -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
