<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-only library: compiles the shared identifier validators and the masking helper they bring (src/Identifiers, src/Privacy),
       so Stryker.NET can mutate them; it never mutates files compiled into a test project (ADR-0020). Core.Tests tests them through
       this copy. Not packed. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- tests/Directory.Build.props adds a global using for xUnit, which this library doesn't reference. -->
  <ItemGroup>
    <Using Remove="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenUrzednik.Core\OpenUrzednik.Core.csproj" />
  </ItemGroup>

  <Import Project="..\..\src\Identifiers\Identifiers.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="OpenUrzednik.Core.Tests" />
  </ItemGroup>

</Project>
