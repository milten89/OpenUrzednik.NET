<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-only library: compiles the DI packages' HttpClient logging (src/Http/DependencyInjection, ADR-0017), so Stryker.NET can
       mutate it; it never mutates files compiled into a test project (ADR-0020). Http.Tests tests it through this copy. Not packed.
       Not through DependencyInjection.props: its DisplayUriRequestOption.cs would clash with the copy in OpenUrzednik.Http.TestHost,
       which this library uses (with, on net472, its polyfills). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- tests/Directory.Build.props adds a global using for xUnit, which this library doesn't reference. -->
  <ItemGroup>
    <Using Remove="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUrzednik.Http.TestHost\OpenUrzednik.Http.TestHost.csproj" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <Compile Include="..\..\src\Http\DependencyInjection\*.cs" Link="Http\DependencyInjection\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenUrzednik.Http.Tests" />
  </ItemGroup>

</Project>
