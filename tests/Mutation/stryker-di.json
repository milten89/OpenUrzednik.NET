{
  "stryker-config": {
    "project": "OpenUrzednik.Nbp.DependencyInjection.csproj",
    "test-projects": [
      "../../tests/OpenUrzednik.Nbp.DependencyInjection.Tests/OpenUrzednik.Nbp.DependencyInjection.Tests.csproj"
    ],
    "test-runner": "mtp",
    "target-framework": "net10.0",
    "concurrency": 1,
    "coverage-analysis": "perTest",
    "mutation-level": "Standard",
    "mutate": [
      "**/*.cs",
      "!**/Polyfills/**",
      "!**/Dto/**"
    ],
    "ignore-methods": [
      "*Log",
      "LogUnreadableBody",
      "*Exception.ctor"
    ],
    "reporters": [
      "html",
      "json",
      "markdown",
      "progress"
    ]
  }
}
