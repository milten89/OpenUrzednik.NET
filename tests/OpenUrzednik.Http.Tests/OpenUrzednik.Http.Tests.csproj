<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The shared HTTP layer (src/Http) is internal source; these tests reach it through OpenUrzednik.Nbp's copy. -->
    <ProjectReference Include="..\..\src\OpenUrzednik.Nbp\OpenUrzednik.Nbp.csproj" />
    <ProjectReference Include="..\OpenUrzednik.TestCommon\OpenUrzednik.TestCommon.csproj" />
  </ItemGroup>

  <!-- The DI packages' HttpClient logging (src/Http/DependencyInjection, ADR-0017) isn't in Nbp, so the tests compile it.
       Not through DependencyInjection.props: its DisplayUriRequestOption.cs would clash with Nbp's copy. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <Compile Include="..\..\src\Http\DependencyInjection\*.cs" Link="Http\DependencyInjection\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
