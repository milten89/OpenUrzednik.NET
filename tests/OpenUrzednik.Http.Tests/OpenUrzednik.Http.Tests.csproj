<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The shared HTTP layer (src/Http) is internal source; these tests reach it through the copy in this test-only library,
         which Stryker.NET mutates in the http shard (ADR-0018). -->
    <ProjectReference Include="..\OpenUrzednik.Http.TestHost\OpenUrzednik.Http.TestHost.csproj" />
    <ProjectReference Include="..\OpenUrzednik.TestCommon\OpenUrzednik.TestCommon.csproj" />
  </ItemGroup>

  <!-- The DI packages' HttpClient logging (src/Http/DependencyInjection, ADR-0017) isn't in OpenUrzednik.Http.TestHost; the tests reach it through this
       test-only library, which Stryker.NET can mutate (ADR-0018). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <ProjectReference Include="..\OpenUrzednik.Http.DependencyInjection.TestHost\OpenUrzednik.Http.DependencyInjection.TestHost.csproj" />
  </ItemGroup>

</Project>
