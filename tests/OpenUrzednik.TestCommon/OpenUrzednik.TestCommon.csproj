<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <!-- Fact and Theory only; the test projects bring the runner. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <!-- ArgumentNullException.ThrowIfNull and friends on .NET Framework; only here, because no other assembly sees these internals. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Include="../../src/Polyfills/ThrowHelpers.cs" Link="Polyfills/ThrowHelpers.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenUrzednik.Core\OpenUrzednik.Core.csproj" />
  </ItemGroup>

</Project>
