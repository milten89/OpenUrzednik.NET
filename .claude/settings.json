{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet format OpenUrzednik.slnx --verify-no-changes:*)",
      "Bash(dotnet list package:*)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git branch --contains:*)",
      "Bash(git branch -r --contains:*)",
      "Bash(git fetch origin)",
      "Bash(git fetch upstream)",
      "Bash(git remote -v)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh project view:*)",
      "Bash(gh project list:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh label list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release verify:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh ruleset view:*)",
      "Bash(gh ruleset list:*)",
      "Bash(gh ruleset check:*)",
      "Bash(gh search:*)",
      "Bash(gh status:*)",
      "Bash(gh cache list:*)",
      "Bash(gh secret list:*)",
      "Bash(gh variable list:*)",
      "Bash(gh api repos/milten89/OpenUrzednik.NET/milestones --jq:*)",
      "Bash(gh api \"repos/milten89/OpenUrzednik.NET/dependabot/alerts?state=open\" --jq length)",
      "Bash(gh api -X POST repos/milten89/OpenUrzednik.NET/releases/generate-notes:*)",
      "Bash(git merge-base --is-ancestor:*)",
      "Bash(git ls-remote --tags origin:*)",
      "Bash(python .claude/skills/prepare-release/scripts/check_nuget.py:*)",
      "Bash(python .claude/skills/prepare-release/scripts/check_packages.py:*)",
      "Bash(curl -s https://api.nbp.pl/:*)",
      "Bash(curl -s https://wykazpodatnikowvat-test.mf.gov.pl/:*)",
      "WebFetch(domain:api.nbp.pl)",
      "WebFetch(domain:nbp.pl)",
      "WebFetch(domain:wykazpodatnikowvat-test.mf.gov.pl)",
      "WebFetch(domain:learn.microsoft.com)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(dotnet nuget push:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-cs.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
