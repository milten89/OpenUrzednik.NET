# Library code only (src/): rules that would be noise in tests. CI turns these warnings into errors
# (TreatWarningsAsErrors in the root Directory.Build.props).

[*.cs]

dotnet_diagnostic.CA1031.severity = warning   # no catch (Exception) or bare catch (ADR-0002)
dotnet_diagnostic.CA2007.severity = warning   # ConfigureAwait(false) on every await (CLAUDE.md)
