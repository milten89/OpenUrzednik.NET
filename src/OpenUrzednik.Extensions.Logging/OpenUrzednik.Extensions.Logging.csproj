<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Unofficial OpenUrzednik.NET adapter for Microsoft.Extensions.Logging: sends the clients' structured logs to ILogger.</Description>
    <PackageTags>Logging;ILogger;API;Poland;Gov</PackageTags>
    <!-- The packages ADR-0004 allows an integration package; src/Directory.Build.targets checks the list. -->
    <OpenUrzednikAllowedPackageReferences>Microsoft.Extensions.Logging.Abstractions</OpenUrzednikAllowedPackageReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUrzednik.Core\OpenUrzednik.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenUrzednik.Extensions.Logging.Tests" />
  </ItemGroup>

</Project>
