<Project>

  <!-- The shared REST/JSON layer (ADR-0006), compiled into each REST provider as internal source, like src/Polyfills.
       A provider imports this file and references, on netstandard2.0 only, Microsoft.Bcl.TimeProvider, System.Net.Http.Json
       and System.Text.Json (ADR-0004). HttpPolyfills.cs holds its own #if, so both folders are linked on every target. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Infrastructure\**\*.cs" Link="Http\Infrastructure\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Polyfills\**\*.cs" Link="Http\Polyfills\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
