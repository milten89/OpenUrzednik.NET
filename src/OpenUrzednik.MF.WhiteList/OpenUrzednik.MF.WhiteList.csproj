<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Unofficial .NET client for the Polish Ministry of Finance VAT White List API (Wykaz podatników VAT). Not affiliated with the Ministry of Finance.</Description>
    <PackageTags>MF;WhiteList;BialaLista;VAT;NIP;REGON;API;Poland;Gov</PackageTags>
    <!-- Not packable until the package has a usable client (ADR-0016, ADR-0023): every merge into develop publishes previews of all
         packable projects. No release yet, so there is no baseline to validate against. -->
    <IsPackable>false</IsPackable>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUrzednik.Core\OpenUrzednik.Core.csproj" />
  </ItemGroup>

  <!-- The shared HTTP layer, compiled in as internal source (ADR-0019). -->
  <Import Project="..\Http\Http.props" />

  <!-- The validators of Polish identifiers and, with them, the masking of src/Privacy, compiled in as internal source (ADR-0003). -->
  <Import Project="..\Identifiers\Identifiers.props" />

  <!-- The shared date helpers and the DateOnly alias for netstandard2.0 (ADR-0005), compiled in as internal source. -->
  <Import Project="..\Dates\Dates.props" />

  <!-- netstandard2.0 only: these types are built into .NET (ADR-0004, ADR-0005). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="System.Net.Http.Json" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenUrzednik.MF.WhiteList.Tests" />
    <!-- NSubstitute (Castle DynamicProxy) mocks internal types in the tests; the key is Castle's public key. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
  </ItemGroup>

</Project>
