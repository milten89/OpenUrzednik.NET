<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- netstandard2.0 for .NET Framework 4.7.2+ (ADR-0005); the .NET targets come from the root props. -->
    <TargetFrameworks>netstandard2.0;$(TargetFrameworks)</TargetFrameworks>
    <!-- Every performance rule (CA18xx) as a build warning: performance comes before convenience in library code. -->
    <AnalysisModePerformance>All</AnalysisModePerformance>
    <!-- In CI, analyzer warnings fail the build (ContinuousIntegrationBuild is set on GitHub Actions in the root props). -->
    <CodeAnalysisTreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</CodeAnalysisTreatWarningsAsErrors>
    <!-- Every pack checks that the builds in a package are compatible: what netstandard2.0 has, net8.0 and net10.0 have with the
         same signatures (ADR-0005), and that the package doesn't break the latest release (ADR-0011). The back-merge after each
         release or hotfix raises the baseline to the released version (docs/RELEASE-PROCESS.md); a package not released yet
         sets an empty PackageValidationBaselineVersion in its csproj. Suppressions: only CP0006 for a new client-interface
         method, and baseline suppressions while version.json carries a new major not released yet. CI packs in the build (net10.0) job. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- The SDK sets a default analysis level and warning level only for .NET 5+, so code only netstandard2.0 compiles
       (#if !NET, Polyfills) got no .NET analyzers, no AnalysisModePerformance rules and only warning level 4 (#246).
       Keep both levels equal to the highest .NET target in the root Directory.Build.props (net10.0). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0</AnalysisLevel>
    <WarningLevel>10</WarningLevel>
  </PropertyGroup>

  <!-- Trimming and Native AOT analyzers (IL2xxx/IL3xxx) on the .NET targets; IsAotCompatible implies IsTrimmable.
       netstandard2.0 doesn't support them (NETSDK1210). -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>

  <!-- Compiler and BCL types .NET has built in; each assembly gets its own internal copy. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Include="$(MSBuildThisFileDirectory)Polyfills\*.cs" Link="Polyfills\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
