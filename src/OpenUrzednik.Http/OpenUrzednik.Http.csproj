<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Shared HTTP layer for OpenUrzednik.NET REST providers: request execution, HTTP status to error mapping, timeouts and telemetry. Intended for provider packages, not for application code.</Description>
    <PackageTags>HTTP;REST;ResultPattern;API;Poland;Gov</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUrzednik.Core\OpenUrzednik.Core.csproj" />
  </ItemGroup>

  <!-- netstandard2.0 only: these types are built into .NET (ADR-0004, ADR-0005). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="System.Net.Http.Json" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenUrzednik.Http.Tests" />
  </ItemGroup>

</Project>
