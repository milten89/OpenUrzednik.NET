<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Microsoft.Extensions.DependencyInjection registration for the OpenUrzednik.NET NBP clients: typed HttpClients, validated options, logging and tracing, ready for AddStandardResilienceHandler().</Description>
    <PackageTags>NBP;DependencyInjection;HttpClientFactory;API;Poland;Gov</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUrzednik.Nbp\OpenUrzednik.Nbp.csproj" />
    <ProjectReference Include="..\OpenUrzednik.Extensions.Logging\OpenUrzednik.Extensions.Logging.csproj" />
    <ProjectReference Include="..\OpenUrzednik.Diagnostics\OpenUrzednik.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenUrzednik.Nbp.DependencyInjection.Tests" />
  </ItemGroup>

</Project>
