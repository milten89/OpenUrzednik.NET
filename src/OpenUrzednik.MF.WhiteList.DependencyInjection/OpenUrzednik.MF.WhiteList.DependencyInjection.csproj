<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Unofficial Microsoft.Extensions.DependencyInjection registration for the OpenUrzednik.NET MF White List clients: typed HttpClients, validated options, logging, tracing and metrics, and logs without identifiers; ready for AddStandardResilienceHandler() on .NET 8 and later.</Description>
    <PackageTags>MF;WhiteList;BialaLista;VAT;DependencyInjection;HttpClientFactory;API;Poland;Gov</PackageTags>
    <!-- Not packable until the provider ships (ADR-0016, ADR-0023), like the base package; no release yet, so no baseline. -->
    <IsPackable>false</IsPackable>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <!-- The packages ADR-0024 allows an integration package; src/Directory.Build.targets checks the list. -->
    <OpenUrzednikAllowedPackageReferences>Microsoft.Extensions.Http;Microsoft.Extensions.Options;Polly.Core</OpenUrzednikAllowedPackageReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUrzednik.MF.WhiteList\OpenUrzednik.MF.WhiteList.csproj" />
    <ProjectReference Include="..\OpenUrzednik.Extensions.Logging\OpenUrzednik.Extensions.Logging.csproj" />
    <ProjectReference Include="..\OpenUrzednik.Diagnostics\OpenUrzednik.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <!-- Marks resilience-handler rejections for the shared HTTP layer compiled into the providers (ADR-0024). -->
  <ItemGroup>
    <Compile Include="..\Http\Infrastructure\ResilienceRejection.cs" Link="Http\ResilienceRejection.cs" />
  </ItemGroup>

  <!-- The HttpClient logging that writes the display path, not the identifier in the URI (ADR-0017). -->
  <Import Project="..\Http\DependencyInjection\DependencyInjection.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="OpenUrzednik.MF.WhiteList.DependencyInjection.Tests" />
  </ItemGroup>

</Project>
